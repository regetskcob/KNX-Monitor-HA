{
  "entity": {
    "event": {
      "watcher_event": { "default": "mdi:bell-ring" },
      "alarm_event": { "default": "mdi:alarm-light" }
    },
    "sensor": {
      "telegrams_per_minute": { "default": "mdi:swap-horizontal" },
      "repeats_per_minute": { "default": "mdi:repeat" },
      "telegrams_today": { "default": "mdi:counter" },
      "bus_load": { "default": "mdi:gauge" },
      "open_alarms": { "default": "mdi:alarm-light" },
      "last_alarm": { "default": "mdi:alert" },
      "availability_24h": { "default": "mdi:lan-check" },
      "health": {
        "default": "mdi:heart-pulse",
        "state": {
          "ok": "mdi:check-circle-outline",
          "hints": "mdi:information-outline",
          "faults": "mdi:alert-circle-outline"
        }
      },
      "health_findings": { "default": "mdi:format-list-checks" }
    },
    "switch": {
      "recording": { "default": "mdi:record-rec" }
    }
  },
  "services": {
    "create_report": { "service": "mdi:file-document-outline" },
    "run_health_check": { "service": "mdi:heart-pulse" },
    "export_history": { "service": "mdi:file-export-outline" }
  }
}
